  "styles": [
    {
      "id": "modern_rustic",
      "name": "Modern Rustic",
      "tags": [
        "rustic",
        "modern",
        "wood",
        "bright"
      ],
      "blurb": "Warm timber and honest texture held in check by clean modern lines — comfortable without ever tipping into fussy.",
      "reveals": {
        "palette": {
          "colors": [
            { "name": "Oat Linen", "hex": "#E5DAC8" },
            { "name": "Weathered Oak", "hex": "#8B6F4E" },
            { "name": "Burnt Clay", "hex": "#A45A34" }
          ],
          "line": "Oat linen keeps it light, weathered oak does the warming, and a burnt clay accent stops the whole thing going soft."
        },
        "mistakes": {
          "setup": "Never let the wood tones in a room match each other exactly, and the way out is",
          "trigger": "to age one piece past the rest,"
        },
        "materials": {
          "setup": "Timber and stone turn muddy without one cold element between them, and it is",
          "trigger": "brushed steel, and only there,"
        },
        "shopping": {
          "setup": "The table matters more than the cabinetry, and the number people get wrong is",
          "trigger": "its height, not its length,"
        },
        "dna": {
          "setup": "Your choices sit closer to the modern half than you would guess, and it shows",
          "trigger": "in the pairs you skipped fast,"
        },
        "splurge": {
          "setup": "Spend on the timber and save on anything you can paint, and what ages worst is",
          "trigger": "the worktop edge, by winter two,"
        }
      }
    },
    {
      "id": "minimalist",
      "name": "Minimalist",
      "tags": [
        "minimal",
        "modern",
        "cool",
        "stone",
        "bright"
      ],
      "blurb": "Nothing on the counter, everything in its place, and daylight doing most of the decorating.",
      "reveals": {
        "palette": {
          "colors": [
            { "name": "Chalk White", "hex": "#F4F4F2" },
            { "name": "Pale Concrete", "hex": "#D5D6D2" },
            { "name": "Graphite", "hex": "#3A3D42" }
          ],
          "line": "Chalk white does the bulk, pale concrete carries the only texture, and graphite appears once — on the handles, nowhere else."
        },
        "mistakes": {
          "setup": "Never solve a storage problem with more cabinetry, because the real fix is",
          "trigger": "one drawer you never fill,"
        },
        "materials": {
          "setup": "Matte over gloss on every surface but one, and the exception that matters is",
          "trigger": "the splashback, honed stone,"
        },
        "shopping": {
          "setup": "Buy the tap last and overspend on it, because in a quiet room the eye lands on",
          "trigger": "the only thing that moves,"
        },
        "dna": {
          "setup": "Your picks run cooler than the average minimalist's, which puts you nearer",
          "trigger": "Scandinavian than Japanese,"
        },
        "splurge": {
          "setup": "Spend on the joinery, save on appliances, and what separates minimal from bare is",
          "trigger": "a two millimetre shadow gap,"
        }
      }
    },
    {
      "id": "industrial",
      "name": "Industrial",
      "tags": [
        "industrial",
        "dark",
        "metal",
        "wood",
        "stone"
      ],
      "blurb": "Raw metal, dark surfaces and structure worn on purpose — your kitchen doesn't hide how it's built.",
      "reveals": {
        "palette": {
          "colors": [
            { "name": "Iron Black", "hex": "#2B2B2B" },
            { "name": "Smoked Oak", "hex": "#5C4A38" },
            { "name": "Zinc Grey", "hex": "#8A8D91" }
          ],
          "line": "Iron black holds the frame, smoked oak warms it back up, and zinc grey keeps those two from fighting each other."
        },
        "mistakes": {
          "setup": "Never buy the pre-distressed version of anything — the giveaway is",
          "trigger": "the repeat in the pattern,"
        },
        "materials": {
          "setup": "Steel, oak and concrete work in one ratio, and the dominant surface should be",
          "trigger": "the darkest one, at sixty percent,"
        },
        "shopping": {
          "setup": "Buy the lighting first, because in this style the fixtures are the architecture and",
          "trigger": "the pendant over the island,"
        },
        "dna": {
          "setup": "Your picks lean into structure over surface, so the influence beneath is",
          "trigger": "warehouse, not workshop,"
        },
        "splurge": {
          "setup": "Spend on the extraction, not the carcasses, because the thing nobody fakes is",
          "trigger": "the weight of the hardware,"
        }
      }
    },
    {
      "id": "classic",
      "name": "Classic",
      "tags": [
        "classic",
        "warm",
        "bright",
        "stone",
        "metal"
      ],
      "blurb": "Shaker doors, honest proportions and materials chosen to look better in ten years than they do today.",
      "reveals": {
        "palette": {
          "colors": [
            { "name": "Bone White", "hex": "#ECE4D6" },
            { "name": "Aged Brass", "hex": "#B08D57" },
            { "name": "Walnut Shadow", "hex": "#5A4632" }
          ],
          "line": "Bone white on the cabinetry, aged brass on everything you actually touch, and walnut shadow keeping the room from floating away."
        },
        "mistakes": {
          "setup": "Never mix more than two metals in one room, and the pairing that always works is",
          "trigger": "brass with nickel, never black,"
        },
        "materials": {
          "setup": "Marble looks right and behaves badly, so the surface to use instead is",
          "trigger": "honed quartzite, softly veined,"
        },
        "shopping": {
          "setup": "Hardware is where a classic kitchen is won or lost, and the one detail to sample is",
          "trigger": "the knurling, under your light,"
        },
        "dna": {
          "setup": "Your answers read classic with a warmer bias than most, which points you",
          "trigger": "toward English country, not French,"
        },
        "splurge": {
          "setup": "Spend on the doors and save on the worktop, because what you touch daily is",
          "trigger": "the door frame, not the top,"
        }
      }
    }
