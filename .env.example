# Copy to .env and fill in. Never commit .env.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=FarvaGO$mazzin

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

BASE_URL=https://mazzin.com

# The admin dashboard. Both empty means /admin answers 503 rather than opening.
# Generate the hash with: python3 scripts/admin_password.py
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Meta Conversions API token for the Visymo pixel, which /ai-navigator uses
# instead of the default one (see the funnel's "pixel" block). Empty means the
# server sends no Purchase for that funnel; it never borrows another token.
META_CAPI_TOKEN_VISYMO=
